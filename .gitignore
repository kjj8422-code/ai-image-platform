# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 실제 값이 없는 스킬 설정 템플릿은 커밋되어야 한다 (.env* 패턴에 걸려 무시되던 버그 수정)
!.claude/skills/*/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
