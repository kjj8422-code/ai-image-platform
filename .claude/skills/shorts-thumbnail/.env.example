# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore(.env*)에 이미 포함되어 있어
# 커밋되지 않습니다.

# 필수 — Supabase에 "Invite user"로 초대받은 계정의 로그인 정보.
AI_PLATFORM_EMAIL=
AI_PLATFORM_PASSWORD=

# 새로 clone한 PC에서는 이 두 줄을 직접 채워야 합니다. 자동으로 읽어오는 대상인
# .env.local은 커밋되지 않아서 갓 받은 저장소에는 없고, 비워둔 채로 실행하면
# "Supabase URL/키를 찾을 수 없습니다"로 멈춥니다.
#   SUPABASE_URL            <- Supabase 대시보드 > Project Settings > Data API 의 Project URL
#   SUPABASE_PUBLISHABLE_KEY <- 같은 설정의 API Keys > Publishable key
# 둘 다 원래 브라우저에 공개되는 값이라 여기 적어도 안전합니다.
# (같은 PC에서 웹 개발도 하고 있어 .env.local이 이미 있다면 비워두셔도 됩니다.)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 선택 — 비워두면 배포된 라이브 사이트를 호출합니다. 로컬 개발 서버로 테스트하려면
# http://localhost:3000 으로 바꾸세요.
AI_PLATFORM_BASE_URL=
