# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore(.env*)에 이미 포함되어 있어
# 커밋되지 않습니다.

# 필수 — Supabase에 "Invite user"로 초대받은 계정의 로그인 정보.
AI_PLATFORM_EMAIL=
AI_PLATFORM_PASSWORD=

# 선택 — 비워두면 같은 저장소의 .env.local에 있는 NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 값을 자동으로 읽어옵니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 선택 — 비워두면 배포된 라이브 사이트를 호출합니다. 로컬 개발 서버로 테스트하려면
# http://localhost:3000 으로 바꾸세요.
AI_PLATFORM_BASE_URL=
